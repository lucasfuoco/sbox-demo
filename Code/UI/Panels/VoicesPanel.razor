@namespace Sandbox.UI.Panels
@using Sandbox.Components
@using Sandbox.Voices
@attribute [StyleSheet]
@inherits Panel

<root>
    @foreach ( var entry in Entries )
    {
        <div class="row">
            <div class="item-row with-background">
                <div class="square rounded shrink-0" style="@entry.RadioStyle"></div>
                <div class="avatar" style="@entry.AvatarStyle"></div>
                <label class="name" style="@entry.NameStyle">@entry.DisplayName</label>
            </div>
        </div>
    }
</root>

@code
{
    public IEnumerable<PlayerVoice> VoiceList => Scene.GetAllComponents<PlayerVoice>().Where( x => x.Client.IsConnected );

    private List<VoiceEntry> Entries => VoiceList
        .Where( CanDisplay )
        .Select( CreateEntry )
        .ToList();

    private bool CanDisplay( PlayerVoice voice ) => voice.LastPlayed < 0.25f;

    private VoiceEntry CreateEntry( PlayerVoice voice )
    {
        var player = voice.GetComponent<ClientComponent>();
        var teamColor = ( player?.Team.GetColor() ?? Color.White ).Hex;
        var scale = ( 1f + 0.5f + ( voice.Amplitude * 2.365f ) ).ToString( "0.#" );

        return new VoiceEntry
        {
            DisplayName = player?.DisplayName ?? "",
            AvatarStyle = $"background-image: url(avatar:{player?.SteamId}); width: 28px; height: 28px; border-radius: 100px; background-size: cover; background-position: center; margin-left: 32px;",
            NameStyle = $"color:{teamColor}",
            RadioStyle = $"background-image: url(/ui/chat/radio.png); width: 24px; height: 24px; background-size: contain; background-position: center; background-repeat: no-repeat; transform: scale({scale});"
        };
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();

        foreach ( var voice in VoiceList )
        {
            if ( !CanDisplay( voice ) )
                continue;

            hash.Add( voice.Amplitude );
            hash.Add( voice.LastPlayed );
            hash.Add( voice.GetComponent<ClientComponent>()?.Id );
        }

        return hash.ToHashCode();
    }

    private sealed class VoiceEntry
    {
        public string DisplayName { get; init; }
        public string AvatarStyle { get; init; }
        public string NameStyle { get; init; }
        public string RadioStyle { get; init; }
    }
}
