@using Sandbox
@using Sandbox.UI.Navigation
@using Sandbox.UI.NavigationHosts
@using Sandbox.UI.Panels
@using Sandbox.Video

@inherits Panel
@implements INavigatorPage
@namespace Sandbox.UI.Panels

<root class="hc1 blur">
    <PagePanel>
        <Header>
            <div class="row gap align-center layout grow">
                <label>Settings</label>
            </div>
        </Header>
        <Body>
            <div style="height: 18%;"/>

            <div class="layout column gap">
                <div class="layout row inset">
                    @foreach (var grouping in VisibleProperties.GroupBy(x => x.Group))
                    {
                        <div class="button standard smaller no-anim extra-x-padding @(SelectedGroup == grouping.Key ? "selected" : "")" onclick=@(() => SetGroup( grouping.Key ) )>@grouping.Key</div>
                    }
                </div>

                <div class="layout padding-insane-x with-scroll column">
                    <VerticalDividerPanel />

                    <div class="column with-bg layout padding-extra with-gap">
                        @if ( SelectedGroup == "Video" )
                        {
                            <div class="layout column with-gap video-hardware-summary">
                                <label class="name">Detected Hardware</label>
                                <label class="description">@HardwareSummary</label>
                                <label class="description">Recommended preset: @GameSettingsSystem.RecommendedVideoQuality</label>
                                <div class="layout row gap">
                                    <div class="button standard smaller no-anim extra-x-padding" onclick=@(() => ApplyRecommended())>Apply Recommended</div>
                                    <div class="button standard smaller no-anim extra-x-padding" onclick=@(() => ResetToRecommended())>Reset to Recommended</div>
                                </div>
                            </div>
                        }

                        @if ( !string.IsNullOrEmpty( SelectedGroup ) )
                        {
                            @foreach ( var property in VisibleProperties.Where( x => x.Group == SelectedGroup ) )
                            {
                                <SettingsEntryPanel Target=@GameSettingsSystem.Current Description=@property OnChanged=@(() => StateHasChanged()) />
                            }
                        }
                    </div>

                    <VerticalDividerPanel />
                </div>
            </div>

            <div class="grow" />
        </Body>

        <Footer>
            <div class="button standard" onclick=@(() => Game.Overlay.ShowBinds())>
                EDIT INPUT BINDINGS
            </div>
            <button class="button standard" onclick=@(()=>Save())>Save</button>
        </Footer>
    </PagePanel>
</root>

@code
{
    private string SelectedGroup { get; set; } = null;

    IEnumerable<PropertyDescription> VisibleProperties =>
        TypeLibrary.GetPropertyDescriptions( GameSettingsSystem.Current )
            .Where( x => !string.IsNullOrEmpty( x.Group ) && x.Name != nameof( GameSettings.HasChosenVideoQuality ) );

    string HardwareSummary => GameSettingsSystem.Capabilities.Summary;

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( firstTime )
        {
            if ( VisibleProperties.Any( x => x.Group == "Video" ) )
                SetGroup( "Video" );
            else
            {
                var first = VisibleProperties.FirstOrDefault();
                if ( first is not null )
                    SetGroup( first.Group );
            }
        }
    }

    private void SetGroup( string group )
    {
        SelectedGroup = group;
        StateHasChanged();
    }

    void Save()
    {
        GameSettingsSystem.Save();
        StateHasChanged();
    }

    void ApplyRecommended()
    {
        GameSettingsSystem.ApplyRecommendedVideoQuality( persist: false );
        SelectedGroup = "Video";
        StateHasChanged();
    }

    void ResetToRecommended()
    {
        GameSettingsSystem.ApplyRecommendedVideoQuality( persist: true );
        SelectedGroup = "Video";
        StateHasChanged();
    }

    public void OnNavigationOpen()
    {
        if ( MainMenuNavigationHost.Instance.IsValid() )
        {
            MainMenuNavigationHost.Instance.SetBlur( true );
        }
    }
    
    public void OnNavigationClose() 
    {
        if ( MainMenuNavigationHost.Instance.IsValid() )
        {
            MainMenuNavigationHost.Instance.SetBlur( false );
        }
    }
}
