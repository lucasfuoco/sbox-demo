@using Sandbox.UI
@using Sandbox
@using Sandbox.UI.BaseControls
@using System

@inherits Panel
@namespace Sandbox.UI.Panels

<style>
    .box {
        width: 24px;
        height: 24px;
    }
</style>

<root class="border-bottom">
    @if ( Description is not null )
    {
        @if ( Description.PropertyType == typeof( float ) || Description.PropertyType == typeof( int ) )
        {
            <div class="with-padding">
                <label class="name">@Description.Title</label>
                <div class="grow" />
            </div>

            <div class="control">
                @if ( Range is not null )
                {
                    <CustomSliderBaseControl style="width: 250px;" class="devslider" Value="@NumericValue" ValueChanged="@OnNumericValueChanged" Min="@Range.Min" Max="@Range.Max" Step="@Range.Step" ShowTextEntry="@false" />
                }
                else
                {
                    <CustomSliderBaseControl class="devslider" Value="@NumericValue" ValueChanged="@OnNumericValueChanged" />
                }
            </div>
        }
        else if ( Description.PropertyType == typeof( bool ) )
        {
            <div class="with-padding border-bottom grow">
                <label class="name">@Description.Title</label>
                <div class="grow" />
                <Checkbox Value="@BoolValue" ValueChanged="@OnBoolValueChanged" />
            </div>
        }
        else if ( Description.PropertyType == typeof( Color ) ) 
        {
            <div class="with-padding border-bottom">
                <label class="name" style="min-width: 64px;">@Description.Title</label>
            </div>

            <div class="control layout column">
                <ColorPicker Value="@ColorValue" ValueChanged="@OnColorValueChanged" />
            </div>
        }
        else if ( Description.PropertyType.IsEnum )
        {
            <div class="with-padding grow">
                <label class="name">@Description.Title</label>
                <div class="grow" />
            </div>

            <div class="control enum-options layout row gap">
                @foreach ( var name in Enum.GetNames( Description.PropertyType ) )
                {
                    var enumValue = Enum.Parse( Description.PropertyType, name );
                    <div class="button standard smaller no-anim extra-x-padding @(Equals( Value, enumValue ) ? "selected" : "")" onclick=@(() => SetEnumValue( enumValue ))>@FormatEnumName( name )</div>
                }
            </div>
        }
    }
    else
    {
        <div class="with-padding border-bottom">
            <label class="name">Unsupported</label>
            <div class="grow" />
        </div>
    }
</root>

@code
{
    public object Target { get; set; }
    public object Value
    {
        get => Description.GetValue( Target );
        set
        {
            Description.SetValue( Target, value );   
        }
    }

    public float NumericValue
    {
        get => Description.PropertyType == typeof( int ) ? (int)Value : Convert.ToSingle( Value );
        set => Description.SetValue( Target, Description.PropertyType == typeof( int ) ? (int)value : value );
    }

    public bool BoolValue
    {
        get => (bool)Value;
        set => Description.SetValue( Target, value );
    }

    public Color ColorValue
    {
        get => (Color)Value;
        set => Description.SetValue( Target, value );
    }

    public PropertyDescription Description { get; set; }

    public Action OnChanged { get; set; }

    public RangeAttribute Range => Description.GetCustomAttribute<RangeAttribute>();

    void OnNumericValueChanged( float value )
    {
        NumericValue = value;
        OnChanged?.Invoke();
    }

    void OnBoolValueChanged( bool value )
    {
        BoolValue = value;
        OnChanged?.Invoke();
    }

    void OnColorValueChanged( Color value )
    {
        ColorValue = value;
        OnChanged?.Invoke();
    }

    void SetEnumValue( object value )
    {
        Description.SetValue( Target, value );

        if ( Target is GameSettings && Description.Name == nameof( GameSettings.VideoQuality ) && value is Sandbox.Video.VideoQualityTier tier )
        {
            GameSettingsSystem.ApplyVideoPreset( tier, persist: false );
        }

        OnChanged?.Invoke();
        StateHasChanged();
    }

    static string FormatEnumName( string name )
    {
        if ( string.IsNullOrEmpty( name ) )
            return name;

        // Insert spaces before capitals for readability (PostProcess -> Post Process stays as enum name).
        return name;
    }
}
