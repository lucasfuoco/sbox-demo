@using Sandbox.UI.Panels
@namespace Sandbox.UI.Panels
@inherits Panel
@attribute [StyleSheet]

<root class="@HiddenClasses flex row">
	<div class="layout flex column" @ref="Layout" />
	<div class="line" />
	<ScrollingNumberPanel class="@ScrollNumberClasses" Value=@Total />
</root>

@code
{
	public Panel Layout { get; set; }
	public int Total { get; set; } = 0;

	public string HiddenClasses => Layout?.Children.Count() < 1 ? "hidden" : "";

	public string ScrollNumberClasses => string.IsNullOrEmpty( HiddenClasses ) ? "scroll number" : "scroll hidden number";

	public void OnScore( int amount, string reason )
	{
		Layout.AddChild( new ScoringEntryPanel()
		{
			Score = amount,
			Reason = reason
		} );

		Total += amount;
	}

	public override void Tick()
	{
		if ( ( Layout?.Children.Count() ?? 0 ) < 1 )
			Total = 0;
	}

	protected override int BuildHash()
	{
		return HashCode.Combine( Total, Layout?.Children.Count() ?? 0 );
	}
}
