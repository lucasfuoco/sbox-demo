// Realistic lake water — calm, dark, low foam

Layer0
{
	shader "shaders/realistic_water.shader"

	F_DO_NOT_CAST_SHADOWS 1
	F_RENDER_BACKFACES 1
	F_TRANSLUCENT 1

	//---- Caustics ----
	g_flCausticsAnimSpeed "0.900"
	g_flCausticsIntensity "0.080"
	g_flCausticsScrollSpeed "0.008"
	g_flCausticsThresholdMax "1.700"
	g_flCausticsThresholdMin "0.400"
	g_flCausticsTilingMultiplier "1.000"

	//---- Depth ----
	g_flAbsorption "0.040"
	g_flDepthBlend "0.950"
	g_flDepthFalloff "0.600"
	g_flDepthMultiplier "0.800"
	g_flShoreOpacity "0.000"
	g_flShoreOpacityRange "10.000"
	g_vDeepColor "[0.011765 0.039216 0.047059 0.941176]"
	g_vScatterColor "[0.023529 0.160784 0.180392]"
	g_vShallowColor "[0.180392 0.360784 0.380392 0.509804]"

	//---- Foam ----
	g_flCrestFoamIntensity "0.150"
	g_flCrestFoamThreshold "0.550"
	g_flFoamCoverage "0.350"
	g_flFoamDepth "35.000"
	g_flFoamEdgeScale "4.500"
	g_flFoamEdgeSpeed "0.080"
	g_flFoamEdgeWarp "0.400"
	g_flFoamFalloff "1.600"
	g_flFoamIntensity "0.450"
	g_flFoamNoiseScale "16.000"
	g_flFoamNoiseSpeed "0.200"
	g_flFoamSoftness "1.400"
	g_vFoamColor "[0.900000 0.930000 0.950000 1.000000]"

	//---- Flow ----
	g_flFlowSpeed "0.020"
	g_vFlowDirection "[0.700000 0.300000]"

	//---- Fresnel ----
	g_flFresnelF0 "0.020"
	g_flFresnelPower "5.500"
	g_vFresnelColor "[0.380000 0.550000 0.620000 1.000000]"

	//---- Lighting ----
	g_flGlitterIntensity "0.300"
	g_flGlitterScale "24.000"
	g_flSpecularIntensity "1.200"
	g_flSpecularPower "280.000"
	g_flSubsurfaceIntensity "0.300"
	g_vSubsurfaceColor "[0.030000 0.280000 0.300000]"
	g_vSunColor "[1.000000 0.960784 0.878431]"
	g_vSunDirection "[0.350000 0.550000 0.750000]"

	//---- Normals ----
	g_flNormalStrength "0.180"
	g_flSpeedMainNormal "40.000"
	g_flSpeedSecondNormal "-55.000"
	MainNormal "textures/water/water_normal.jpg"
	SecondNormal "textures/water/water_normal.jpg"

	//---- Reflection ----
	g_bUseScreenSpaceReflection "1"
	g_flFoamReflectionStrength "0.100"
	g_flHorizonStrength "0.450"
	g_flReflectionStepSize "1000.000"
	g_flReflectionStrength "0.950"
	g_vHorizonColor "[0.350000 0.500000 0.620000]"

	//---- Refraction ----
	g_flRefractionStrength "0.060"

	//---- Surface ----
	g_flContrast "1.100"
	g_flRoughness "0.050"
}
