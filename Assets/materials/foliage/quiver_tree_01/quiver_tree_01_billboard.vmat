// Camera-facing quiver tree 01 cutout billboard

Layer0
{
	shader "shaders/foliage.shader"

	F_ALPHA_TEST 1
	F_RENDER_BACKFACES 1
	F_SPECULAR 1

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "materials/foliage/quiver_tree_01/quiver_tree_01_billboard_color.png"
	TextureTranslucency "materials/foliage/quiver_tree_01/quiver_tree_01_billboard_trans.png"
	TextureNormal "materials/foliage/quiver_tree_01/quiver_tree_01_billboard_normal_dx.png"

	g_flAlphaTestReference "0.300"
	g_flAlphaDistanceStart "2000.000"
	g_flAlphaDistanceEnd "12000.000"
	g_flRoughnessScaleFactor "0.850"
	g_flMinRoughness "0.550"
	g_bFogEnabled "1"
	g_vTexCoordOffset "[0.000 0.000]"
	g_vTexCoordScale "[1.000 1.000]"
	g_vTexCoordScrollSpeed "[0.000 0.000]"
}
